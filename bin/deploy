#!/usr/bin/env bash
set -e
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
BASEDIR=$(dirname $DIR)
cd $BASEDIR
PREV_MD5SUM="$(md5sum requirements.txt)"
git fetch
git reset origin/master --hard
source $BASEDIR/env/bin/activate
source ~/.nvm/nvm.sh
NEW_MD5SUM="$(md5sum requirements.txt)"
if [ "$PREV_MD5SUM" != "$NEW_MD5SUM" ]
then
  source $BASEDIR/env/bin/activate
  source ~/.cargo/env
  source ~/.local/bin/env
  uv pip install --no-cache --requirement requirements.txt
fi
python manage.py migrate --noinput
python manage.py build_frontend
find static/ -type f -name "*.js" -print0 | while IFS= read -r -d '' file; do
  if [ ! -f "$file.gz" ]; then
    gzip --best --keep $file
  fi
  if [ ! -f "$file.br" ]; then
    brotli --best --keep $file
  fi
done
find static/ -type f -name "*.css" -print0 | while IFS= read -r -d '' file; do
  if [ ! -f "$file.gz" ]; then
    gzip --best --keep $file
  fi
  if [ ! -f "$file.br" ]; then
    brotli --best --keep $file
  fi
done
./bin/reload
